# Add directories or file patterns to ignore during indexing (e.g. foo/ or *.csv)
src/data/*
!src/data/.gitkeep

src/db/*
!src/db/.gitkeep

node_modules/*
!node_modules/.gitkeep

dist/*
!dist/.gitkeep

.astro/*
!astro/.gitkeep

.vscode/*
!vscode/.gitkeep

.env
!.env.example

.gitignore
!.gitignore.example

.cursorignore
!.cursorignore.example

.cursorignore
!.cursorignore.example