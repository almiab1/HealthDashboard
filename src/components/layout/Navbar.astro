---
import { Activity, Menu, LayoutDashboard, ClipboardList, BookOpen, Settings } from 'lucide-react';

const navItems = [
  { label: 'Dashboard', href: '/', icon: LayoutDashboard },
  { label: 'Historial', href: '/history', icon: ClipboardList },
  { label: 'Guía', href: '/guia', icon: BookOpen },
  { label: 'Configuración', href: '/settings', icon: Settings },
];

const currentPath = Astro.url.pathname;
---

<nav class="sticky top-0 z-50 border-b border-[#1e3327] bg-[#0d1a12]">
  <div class="flex h-14 items-center justify-between px-4 lg:px-8">
    {/* Logo - Always visible */}
    <div class="flex items-center gap-2">
        <div class="bg-emerald-500/20 p-1.5 rounded-full">
            <Activity className="h-4 w-4 text-emerald-400" />
        </div>
        <span class="font-semibold text-sm sm:text-base tracking-tight text-white">NutriTrack</span>
    </div>

    {/* Navigation Links - Hidden on mobile */}
    <div class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200 
            ${currentPath === item.href 
              ? 'bg-emerald-500/10 text-emerald-400' 
              : 'text-gray-400 hover:text-emerald-300 hover:bg-emerald-500/5'}`}
        >
          <item.icon className="h-4 w-4" />
          {item.label}
        </a>
      ))}
    </div>

    {/* Right Section */}
    <div class="flex items-center gap-2 sm:gap-3">
        {/* Mobile Menu Button */}
        <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-400 hover:text-white transition-colors">
            <Menu className="h-5 w-5" id="menu-icon" />
        </button>
    </div>
  </div>
  
  {/* Mobile Menu - Hidden by default */}
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#1e3327] bg-[#111c16]">
    <div class="px-4 py-3 space-y-1">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors 
            ${currentPath === item.href 
              ? 'bg-[#1e3327] text-emerald-400' 
              : 'text-gray-400 hover:bg-[#162119] hover:text-white'}`}
        >
          <item.icon className="h-4 w-4" />
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
