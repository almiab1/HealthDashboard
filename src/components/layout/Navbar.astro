---
import { Activity, LayoutDashboard, ClipboardList, BookOpen, Settings } from 'lucide-react';

const navItems = [
  { label: 'Dashboard', href: '/', icon: LayoutDashboard },
  { label: 'Historial', href: '/history', icon: ClipboardList },
  { label: 'Guía', href: '/guia', icon: BookOpen },
  { label: 'Config', href: '/settings', icon: Settings },
];

const currentPath = Astro.url.pathname;
---

{/* Top navbar */}
<nav class="sticky top-0 z-50 border-b border-[#1e3327] bg-[#0d1a12]">
  <div class="flex h-14 items-center justify-between px-4 lg:px-8">
    {/* Logo - Always visible */}
    <div class="flex items-center gap-2">
        <div class="bg-emerald-500/20 p-1.5 rounded-full">
            <Activity className="h-4 w-4 text-emerald-400" />
        </div>
        <span class="font-semibold text-sm sm:text-base tracking-tight text-white">NutriTrack</span>
    </div>

    {/* Navigation Links - Hidden on mobile */}
    <div class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200
            ${currentPath === item.href
              ? 'bg-emerald-500/10 text-emerald-400'
              : 'text-gray-400 hover:text-emerald-300 hover:bg-emerald-500/5'}`}
        >
          <item.icon className="h-4 w-4" />
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>

{/* Mobile Bottom Tab Bar */}
<nav class="fixed bottom-0 left-0 right-0 z-50 md:hidden border-t border-[#1e3327] bg-[#0d1a12]">
  <div class="flex items-center justify-around h-16 px-2">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`flex flex-col items-center justify-center gap-1 flex-1 py-2 transition-colors
          ${currentPath === item.href
            ? 'text-emerald-400'
            : 'text-gray-500 hover:text-gray-300'}`}
      >
        <item.icon className="h-5 w-5" />
        <span class="text-[10px] font-medium">{item.label}</span>
      </a>
    ))}
  </div>
</nav>
