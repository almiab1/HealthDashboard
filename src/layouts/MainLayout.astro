---
import '@fontsource/inter';
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import { Toaster } from 'sonner';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Dashboard de Salud" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style>
			/* Hide scrollbar for filters on mobile */
			.scrollbar-hide::-webkit-scrollbar {
				display: none;
			}
			.scrollbar-hide {
				-ms-overflow-style: none;
				scrollbar-width: none;
			}
		</style>
	</head>
	<body class="min-h-screen bg-[#0d1a12] text-white antialiased">
        <Toaster client:load position="top-center" theme="dark" richColors />
        <Navbar />
        <div class="px-4 py-5 sm:px-6 sm:py-6 lg:px-8 lg:py-8 max-w-screen-xl mx-auto">
            <main>
		        <slot />
            </main>
        </div>
	</body>
</html>
