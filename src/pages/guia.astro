---
import MainLayout from '@/layouts/MainLayout.astro';
import { GuideCards } from '@/components/guide/GuideCards';
---

<MainLayout title="Guia de Interpretacion | NutriTrack">
    <div class="max-w-5xl mx-auto pb-12 space-y-8">

        {/* Header */}
        <div class="space-y-4 border-b border-[#1e3327] pb-6">
            <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">Guia de Interpretacion</h1>
            <p class="text-gray-400 text-lg leading-relaxed max-w-3xl">
                Esta guia te ayudara a entender cada uno de los campos de tus informes de bioimpedancia (Tanita MC-780MA),
                que indican sobre tu salud y como interpretar tu progreso.
            </p>
        </div>

        {/* Interactive Guide Cards */}
        <GuideCards client:load />

    </div>
</MainLayout>
