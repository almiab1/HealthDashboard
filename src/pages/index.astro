---
import MainLayout from '@/layouts/MainLayout.astro';
import { MetricCard } from '@/components/dashboard/MetricCard';
import RecentTable from '@/components/dashboard/RecentTable.astro';
import { DateFilter } from '@/components/dashboard/DateFilter';
import { getProcessedData, getLastRecordWithDelta } from '@/utils/dataProcessor';
import { DashboardDesktop } from '@/components/dashboard/DashboardDesktop';
import { Plus } from 'lucide-react';

export const prerender = false;

// En modo Tauri, no hacemos SSR - el cliente cargará los datos
const isTauriBuild = import.meta.env.TAURI_BUILD === true || import.meta.env.TAURI_BUILD === 'true';
console.log('[index.astro] TAURI_BUILD:', import.meta.env.TAURI_BUILD, 'isTauriBuild:', isTauriBuild);

// Solo cargar datos del servidor si NO es Tauri
const data = isTauriBuild ? [] : await getProcessedData();
const lastRecord = isTauriBuild ? null : await getLastRecordWithDelta();

// Handle case where no data exists yet (new install or empty DB)
const hasData = lastRecord !== null;
const delta = hasData ? lastRecord.delta : null;
const previousRecord = (hasData && data.length > 1) ? data[data.length - 2] : null;
---

<MainLayout title="Dashboard de Salud">
  {isTauriBuild ? (
    <DashboardDesktop client:only="react" />
  ) : (
  <div class="space-y-6 lg:space-y-8">
    {/* Header Section - Stacked on mobile, row on larger screens */}
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Hola, Alex</h1>
            <p class="text-gray-500 mt-1 text-sm sm:text-base">Aquí puedes ver tu progreso semanal.</p>
        </div>
        <a href="/register" class="w-full sm:w-auto bg-emerald-500 hover:bg-emerald-400 text-black font-bold py-2.5 px-5 rounded-lg flex items-center justify-center transition-colors shadow-lg shadow-emerald-500/20">
            <Plus className="mr-2 h-5 w-5" />
            Registrar Nuevas Medidas
        </a>
    </div>

    {/* Section Title & Filters */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4 lg:mb-5">
        <h2 class="text-sm sm:text-base font-semibold text-white">Progreso a lo Largo del Tiempo</h2>
        <DateFilter client:load />
    </div>

    {/* Metrics Grid - 1 column mobile, 2 tablet, 3 desktop */}
    <div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5">
            {hasData ? (
            <>
                <MetricCard 
                    client:load
                    title="Peso (kg)" 
                    value={lastRecord.Peso} 
                    unit="kg" 
                    delta={delta?.Peso} 
                    inverseTrend={true}
                    data={data}
                    dataKey="Peso"
                    color="#4ade80"
                />
                <MetricCard 
                    client:load
                    title="Porcentaje de Grasa (%)" 
                    value={lastRecord.GrasaPorc} 
                    unit="%" 
                    delta={delta?.GrasaPorc} 
                    inverseTrend={true}
                    data={data}
                    dataKey="GrasaPorc"
                    color="#d97706"
                />
                <MetricCard 
                    client:load
                    title="Masa Muscular (kg)" 
                    value={lastRecord.MusculoKg} 
                    unit="kg" 
                    delta={delta?.MusculoKg} 
                    inverseTrend={false}
                    data={data}
                    dataKey="MusculoKg"
                    color="#38bdf8"
                />
            </>
            ) : (
                <div class="col-span-full text-center py-10 text-gray-500">
                    No hay registros disponibles. Empieza registrando una nueva medida.
                </div>
            )}
        </div>
    </div>

    {/* Recent History Table */}
    {hasData && (
    <div>
        <h2 class="text-sm sm:text-base font-semibold text-white mb-4 lg:mb-5">Último Registro</h2>
        <RecentTable lastRecord={lastRecord} previousRecord={previousRecord} />
    </div>
    )}
  </div>
  )}
</MainLayout>
