---
import MainLayout from '@/layouts/MainLayout.astro';
import { MetricCard } from '@/components/dashboard/MetricCard';
import RecentTable from '@/components/dashboard/RecentTable.astro';
import { DateFilter } from '@/components/dashboard/DateFilter';
import { getProcessedData, getLastRecordWithDelta } from '@/utils/dataProcessor';
import { DashboardDesktop } from '@/components/dashboard/DashboardDesktop';
import { getSettingValue } from '@/utils/settings';
import { Plus } from 'lucide-react';
import { EmptyState } from '@/components/ui/EmptyState';

export const prerender = false;

// En modo Tauri, no hacemos SSR - el cliente cargará los datos
const isTauriBuild = import.meta.env.TAURI_BUILD === true || import.meta.env.TAURI_BUILD === 'true';
console.log('[index.astro] TAURI_BUILD:', import.meta.env.TAURI_BUILD, 'isTauriBuild:', isTauriBuild);

// Solo cargar datos del servidor si NO es Tauri
const data = isTauriBuild ? [] : await getProcessedData();
const lastRecord = isTauriBuild ? null : await getLastRecordWithDelta();

// Obtener nombre de usuario desde configuración
const userName = isTauriBuild ? 'Usuario' : await getSettingValue('userName', 'Usuario');

// Handle case where no data exists yet (new install or empty DB)
const hasData = lastRecord !== null;
const delta = hasData ? lastRecord.delta : null;
const previousRecord = (hasData && data.length > 1) ? data[data.length - 2] : null;
---

<MainLayout title="Dashboard de Salud">
  {isTauriBuild ? (
    <DashboardDesktop client:only="react" />
  ) : (
  <div class="flex flex-col h-[calc(100vh-110px)] overflow-hidden">
    {/* Header Section */}
    <div class="flex-shrink-0 flex flex-col gap-2 lg:flex-row lg:items-end lg:justify-between mb-3">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Hola, {userName}</h1>
            <p class="text-gray-500 mt-0.5 text-sm">Aquí puedes ver tu progreso semanal.</p>
        </div>
        <a href="/register" class="w-full sm:w-auto bg-emerald-500 hover:bg-emerald-400 text-black font-bold py-2 px-4 rounded-lg flex items-center justify-center transition-colors shadow-lg shadow-emerald-500/20 text-sm">
            <Plus className="mr-2 h-4 w-4" />
            Registrar Nuevas Medidas
        </a>
    </div>

    {/* Section Title & Filters */}
    <div class="flex-shrink-0 flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
        <h2 class="text-sm font-semibold text-white">Progreso a lo Largo del Tiempo</h2>
        <DateFilter client:load />
    </div>

    {/* Main Content - Two Column Layout: Charts LEFT (wide), Table RIGHT (narrow) */}
    <div class="flex-1 min-h-0 flex flex-col md:flex-row gap-3">
        {/* Left Column: Metrics with Charts - Takes most space */}
        <div class="flex-1 flex flex-col gap-2 order-2 md:order-1">
            {hasData ? (
            <Fragment>
                <div class="flex-1 min-h-[100px]">
                    <MetricCard
                        client:load
                        title="Peso (kg)"
                        value={lastRecord.Peso}
                        unit="kg"
                        delta={delta?.Peso}
                        inverseTrend={true}
                        data={data}
                        dataKey="Peso"
                        color="#4ade80"
                    />
                </div>
                <div class="flex-1 min-h-[100px]">
                    <MetricCard
                        client:load
                        title="Porcentaje de Grasa (%)"
                        value={lastRecord.GrasaPorc}
                        unit="%"
                        delta={delta?.GrasaPorc}
                        inverseTrend={true}
                        data={data}
                        dataKey="GrasaPorc"
                        color="#d97706"
                    />
                </div>
                <div class="flex-1 min-h-[100px]">
                    <MetricCard
                        client:load
                        title="Masa Muscular (kg)"
                        value={lastRecord.MusculoKg}
                        unit="kg"
                        delta={delta?.MusculoKg}
                        inverseTrend={false}
                        data={data}
                        dataKey="MusculoKg"
                        color="#38bdf8"
                    />
                </div>
            </Fragment>
            ) : (
                <EmptyState
                    client:load
                    iconName="chart"
                    title="Sin registros todavia"
                    description="Registra tu primera medicion corporal para comenzar a ver tu progreso aqui."
                    ctaLabel="Registrar Nuevas Medidas"
                    ctaHref="/register"
                />
            )}
        </div>

        {/* Right Column: Recent History Table - ~33% width */}
        {hasData && (
        <div class="w-full md:w-[33%] flex-shrink-0 order-1 md:order-2">
            <RecentTable lastRecord={lastRecord} previousRecord={previousRecord} />
        </div>
        )}
    </div>
  </div>
  )}
</MainLayout>
