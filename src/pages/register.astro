---
import MainLayout from '@/layouts/MainLayout.astro';
import { ArrowLeft } from 'lucide-react';
import { RegisterForm } from '@/components/register/RegisterForm';

export const prerender = false;
---

<MainLayout title="Registrar Medidas - Dashboard de Salud">
  <div class="space-y-6 lg:space-y-8">
    {/* Header Section */}
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex items-center gap-3">
            <a 
                href="/" 
                class="p-2 rounded-lg bg-[#111c16] border border-[#1e3327] hover:bg-[#162119] transition-colors"
            >
                <ArrowLeft className="h-5 w-5 text-gray-400" />
            </a>
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Registrar Nuevas Medidas</h1>
                <p class="text-gray-500 mt-1 text-sm sm:text-base">Añade manualmente o importa desde CSV</p>
            </div>
        </div>
    </div>

    {/* Form Container */}
    <div class="rounded-xl bg-[#111c16] border border-[#1e3327] p-6 lg:p-8">
        <RegisterForm client:only="react" />
    </div>
  </div>
</MainLayout>


