---
import MainLayout from '@/layouts/MainLayout.astro';
import { getProcessedData } from '@/utils/dataProcessor';
import { DownloadButton } from '@/components/ui/DownloadButton';

const data = await getProcessedData();
const totalRecords = data.length;
const firstRecordDate = totalRecords > 0 ? data[0].Fecha.toLocaleDateString('es-ES') : '-';
const lastRecordDate = totalRecords > 0 ? data[data.length - 1].Fecha.toLocaleDateString('es-ES') : '-';
---

<MainLayout title="Configuración">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Configuración</h1>
            <p class="text-gray-500 mt-1 text-sm sm:text-base">Administra tus datos y preferencias</p>
        </div>

        <!-- Data Management Card -->
        <div class="bg-[#111c16] border border-[#1e3327] rounded-xl overflow-hidden">
            <div class="p-6 border-b border-[#1e3327]">
                <div class="flex items-center gap-3">
                    <div class="bg-emerald-500/20 p-2 rounded-lg">
                        <svg class="h-5 w-5 text-emerald-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
                            <path d="M3 12A9 3 0 0 0 21 12"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-white">Gestión de Datos</h2>
                        <p class="text-sm text-gray-500">Exporta tus registros de mediciones corporales</p>
                    </div>
                </div>
            </div>

            <div class="p-6">
                <!-- Stats -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                    <div class="bg-[#0d1712] border border-[#1e3327] rounded-lg p-4">
                        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Total Registros</p>
                        <p class="text-2xl font-bold text-white">{totalRecords}</p>
                    </div>
                    <div class="bg-[#0d1712] border border-[#1e3327] rounded-lg p-4">
                        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Primer Registro</p>
                        <p class="text-lg font-semibold text-white">{firstRecordDate}</p>
                    </div>
                    <div class="bg-[#0d1712] border border-[#1e3327] rounded-lg p-4">
                        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Último Registro</p>
                        <p class="text-lg font-semibold text-white">{lastRecordDate}</p>
                    </div>
                </div>

                <!-- Export Section -->
                <div class="border-t border-[#1e3327] pt-6">
                    <h3 class="text-sm font-medium text-white mb-3">Exportar Datos</h3>
                    <p class="text-sm text-gray-400 mb-4">
                        Descarga todos tus registros en formato CSV para usar en hojas de cálculo como Excel o Google Sheets.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row gap-4 items-start">
                        <DownloadButton 
                            client:load 
                            data={data} 
                            label="Descargar CSV" 
                        />
                        <div class="flex items-start gap-2 text-xs text-gray-500">
                            <svg class="h-4 w-4 mt-0.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" x2="2" y1="12" y2="12"></line>
                                <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
                                <line x1="6" x2="6.01" y1="16" y2="16"></line>
                                <line x1="10" x2="10.01" y1="16" y2="16"></line>
                            </svg>
                            <span>El archivo incluirá todas las métricas: peso, IMC, masa muscular, grasa corporal, agua corporal, y más.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</MainLayout>
